REDIS_URL=redis://localhost:6379
REDIS_STREAM=paper-signals
ALPHA_ID=alpha-1-scale
TF=15m
OFFSET_CANDLE_SEC=5.0

# Indicators — mirror backtest_v5 defaults
SMA_LEN=50
ATR_LEN=200
POC_LEN=30
NORM_WINDOW=252
THRESHOLD=0.15

# Risk
TRAIL_ATR_MULT=0.5
TP_RATIO=3.0
POC_FILTER_PCT=0.02

# Dynamic position sizing
CAPITAL=10000.0
INVEST_PER_TRADE=1000.0
MIN_INVEST=500.0
SCALE_FACTOR=0.30

LEVERAGE=10
MAX_CONCURRENT_POSITIONS=500
WARMUP_BARS=400

# System
LOG_LEVEL=debug
EXCHANGE=binance
FEE_PCT=0.000357

# Per-symbol max leverage JSON (mounted via docker-compose volume)
LEVERAGE_FILE=/app/data/binance_futures_leverage.json

# File-based blacklist — path inside the container (mounted via docker-compose volume)
BLACKLIST_FILE=/app/blacklist.txt
