REDIS_URL=redis://paper-redis:6379
REDIS_STREAM=paper-signals
ALPHA_ID=15m-blend-close
TF=15m
OFFSET_CANDLE_SEC=5.0

# Portfolio/risk parameters from the Markdown spec
CAPITAL=10000.0
WARMUP_BARS=5761
DATA_MAX_CANDLES=5761
MAX_CONCURRENT_POSITIONS=180
FEE_PCT=0.0007
LEVERAGE=1

# System
INITIAL_DATA_TIMEOUT_SEC=900
MANAGE_INTERVAL_SEC=60
LOG_LEVEL=info
EXCHANGE=binance
SPEC_FILE=/app/spec.json
UNIVERSE_FILE=/app/data/universe.json
BLACKLIST_FILE=/app/blacklist.txt
MDS_REDIS_URL=redis://mds-redis:6379
MDS_EXCHANGE=binance
