REDIS_URL=redis://paper-redis:6379
REDIS_STREAM=paper-signals
ALPHA_ID=alpha-2
TF=4h
HTF=12h
OFFSET_CANDLE_SEC=5.0

# Logic Lệnh Parameters
SMA_LEN=85
DIFF_LAG=5
DENOM_LEN=500
TREND_UP=0.1
TREND_DN=-0.1

OPI_LEN=85
OPI_PCT=65.0

USE_VT=true
TARGET_VOL=0.30
VT_DAYS=30
VT_CAP=1.0

# Sizing
CAPITAL=10000.0
INVEST_PER_TRADE=1000.0
MIN_INVEST=500.0

# Trade duration guards
MAX_TRADE_BARS=500
MIN_HOLD_BARS=0

LEVERAGE=10
MAX_CONCURRENT_POSITIONS=500
WARMUP_BARS=900

# System
LOG_LEVEL=debug
EXCHANGE=binance
FEE_PCT=0.000357

# Per-symbol max leverage JSON (mounted via docker-compose volume)
LEVERAGE_FILE=/app/data/binance_futures_leverage.json

# File-based blacklist — path inside the container (mounted via docker-compose volume)
BLACKLIST_FILE=/app/blacklist.txt

# External MDS
MDS_REDIS_URL=redis://mds-redis:6379
MDS_EXCHANGE=binance
