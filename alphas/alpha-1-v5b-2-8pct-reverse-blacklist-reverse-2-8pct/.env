REDIS_URL=redis://paper-redis:6379
REDIS_STREAM=paper-signals
ALPHA_ID=alpha-1-v5b-2-8pct-reverse-blacklist-reverse-2-8pct
TF=15m
OFFSET_CANDLE_SEC=5.0

# Core indicators — mirror backtest defaults
SMA_LEN=50
ATR_LEN=200
POC_LEN=30
NORM_WINDOW=252
THRESHOLD=0.15

# Risk — v5b improvements
TRAIL_ATR_MIN=0.45
TRAIL_ATR_MAX=0.55
TP_RATIO=2.0
POC_FILTER_PCT=0.02
INITIAL_FIXED_TP_SL_PCT=0.028

# Dynamic position sizing (scale pool + Kelly multiplier)
CAPITAL=10000.0
INVEST_PER_TRADE=1000.0
MIN_INVEST=500.0
SCALE_FACTOR=0.30
KELLY_LOOKBACK=20
KELLY_BASE_WR=0.5

# Trade duration guards
MAX_TRADE_BARS=500
MIN_HOLD_BARS=4

LEVERAGE=10
MAX_CONCURRENT_POSITIONS=500
WARMUP_BARS=400

# System
LOG_LEVEL=debug
EXCHANGE=binance
FEE_PCT=0.000357

# Per-symbol max leverage JSON (mounted via docker-compose volume)
LEVERAGE_FILE=/app/data/binance_futures_leverage.json

# File-based blacklist — path inside the container (mounted via docker-compose volume)
BLACKLIST_FILE=/app/blacklist.txt

# External MDS
MDS_REDIS_URL=redis://mds-redis:6379
MDS_EXCHANGE=binance
