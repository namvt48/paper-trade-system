REDIS_URL=redis://paper-redis:6379
REDIS_STREAM=paper-signals
ALPHA_ID=alpha-1-q3
TF=15m
OFFSET_CANDLE_SEC=5.0

# Indicator params
SMA_LEN=50
ATR_LEN=200
POC_LEN=30
NORM_WINDOW=252
THRESHOLD=0.15

# Q3 Small Cap — rank 400-600 by 24h futures volume
VOLUME_RANK_START=400
VOLUME_RANK_END=600

# Strategy params
TRAIL_ATR_MIN=1.00
TRAIL_ATR_MAX=1.50
TP_RATIO=3.0
POC_FILTER_PCT=0.04

# Sizing
CAPITAL=10000.0
INVEST_PER_TRADE=1000.0
MIN_INVEST=500.0
SCALE_FACTOR=0.30
KELLY_LOOKBACK=20
KELLY_BASE_WR=0.5

# Trade guards
MAX_TRADE_BARS=500
MIN_HOLD_BARS=10

# Risk
LEVERAGE=3
MAX_CONCURRENT_POSITIONS=200
WARMUP_BARS=400

# System
LOG_LEVEL=info
EXCHANGE=binance
FEE_PCT=0.000357

LEVERAGE_FILE=/app/data/binance_futures_leverage.json
BLACKLIST_FILE=/app/blacklist.txt

# External MDS
MDS_REDIS_URL=redis://mds-redis:6379
MDS_EXCHANGE=binance
