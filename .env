# ─── Ports ───────────────────────────────────────────────────────────────────
WEB_PORT=8097           # public port for the web dashboard
REDIS_PORT=6382         # public port for Redis (internal always 6379)

# ─── System ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REGISTERED_ALPHAS=alpha-1-v5b,alpha-1-q1,alpha-1-q2,alpha-1-q3
DASHBOARD_CACHE_MS=1000
SIGNAL_RETENTION_DAYS=0

# ─── Worker ──────────────────────────────────────────────────────────────────
SLIPPAGE_PCT=0.05
DUPLICATE_POSITION_POLICY=reject
REDIS_READ_COUNT=100
REDIS_BLOCK_MS=1000

# ─── External MDS connection for alpha containers ────────────────────────────
# Alpha containers join the MDS Docker network and reach Redis by this alias.
MDS_REDIS_URL=redis://mds-redis:6379
MDS_EXCHANGE=binance
