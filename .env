# ─── Ports ───────────────────────────────────────────────────────────────────
WEB_PORT=8096           # public port for the web dashboard
REDIS_PORT=6382         # public port for Redis (internal always 6379)

# ─── System ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REGISTERED_ALPHAS=15m-blend-close,15m-blend-close-b,1h-blend-close,1h-blend-close-c,1h-decay-close,15m-blend-close-36h,15m-blend-close-b-36h,1h-decay-close-36h,1h-decay-vwap-36h,15m-blend-close-2-v3,1h-decay-close-v3,4h-trend-close-v3,4h-trend-z,15m-breakout,1h-trend-breakout,4h-amihud,1h-trend-skew,songthanv8,songthanv11,alpha-1-bangoc,alpha-1-v5b,alpha-1-v5b-2-8pct-reverse-blacklist-reverse-2-8pct,alpha-1-v5b-reverse-blacklist-base-reverse,alpha-2,hyper-turbo,alpha2-NR-Long-Short-M15,alpha2-NR-Long-Short-H1,deobietcophaialphakhong,15m-trend-close-36h-reverse,15m-trend-vwap-36h-reverse,short-btc-v1,1d-kertrend,1d-trend60cmf,1d-vwaprev,1d-chmom,1d-iamp,ensemble-1d,xau-m30-alpha-4,xau-m30-alpha-5,xau-m30-alpha-6,xau-m30-alpha-10,xau-m30-alpha-11,xau-m30-alpha-12
DASHBOARD_CACHE_MS=1000
SIGNAL_RETENTION_DAYS=0

# ─── Worker ──────────────────────────────────────────────────────────────────
SLIPPAGE_PCT=0.05
ENABLE_ORDERBOOK=false
ORDERBOOK_SUPPORTED_EXCHANGES=binance
DUPLICATE_POSITION_POLICY=reject
REDIS_READ_COUNT=100
REDIS_BLOCK_MS=1000

# ─── External MDS connection for alpha containers ────────────────────────────
# Alpha containers join the MDS Docker network and reach Redis by this alias.
MDS_REDIS_URL=redis://mds-redis:6379
MDS_EXCHANGE=binance
