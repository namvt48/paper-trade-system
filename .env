# ─── Ports ───────────────────────────────────────────────────────────────────
WEB_PORT=8096           # public port for the web dashboard
REDIS_PORT=6382         # public port for Redis (internal always 6379)

# ─── System ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REGISTERED_ALPHAS=1h-blend-close,1h-blend-close-c,4h-amihud,1h-trend-skew,alpha-1-bangoc,alpha-1-v5b-reverse-blacklist-base-reverse,alpha-2,hyper-turbo,alpha2-NR-Long-Short-M15,alpha2-NR-Long-Short-H1,deobietcophaialphakhong,15m-trend-close-36h-reverse,15m-trend-vwap-36h-reverse,short-btc-v1,1d-trend60cmf,1d-vwaprev,1d-chmom,1d-iamp,ensemble-1d,xau-m30-alpha-4,xau-m30-alpha-5,xau-m30-alpha-6,xau-m30-alpha-10,xau-m30-alpha-11,xau-m30-alpha-12,15m-blend-close-sleeve,15m-blend-close-2-v3-sleeve,15m-blend-close-36h-sleeve,15m-blend-close-b-sleeve,15m-blend-close-b-36h-sleeve,15m-breakout-sleeve,1h-blend-close-sleeve,1h-blend-close-c-sleeve,1h-decay-close-sleeve,1h-decay-close-36h-sleeve,1h-decay-close-v3-sleeve,1h-decay-vwap-36h-sleeve,1h-trend-breakout-sleeve,1h-trend-skew-sleeve,4h-amihud-sleeve,4h-trend-close-v3-sleeve,4h-trend-z-sleeve,vn30-alpha-19,vn30-alpha-21,suplo-atr1-5,suplo-xau-v3-stepwise,xau-v3-mfe-atr,supertrend-adx-tp,supertrend-adx-ema13-tp,smooth-chan-3to2-15,smooth-chan-3to15-20,smooth-chan-3to2-8,exit-lab-baseline,supertrend-h1-gold,smooth-chan-m15-f8,bollinger-meanrev-avax,bollinger-meanrev-ada,bollinger-meanrev-doge,bollinger-meanrev-dot
DASHBOARD_CACHE_MS=1000
SIGNAL_RETENTION_DAYS=0

# ─── Worker ──────────────────────────────────────────────────────────────────
SLIPPAGE_PCT=0.05
ENABLE_ORDERBOOK=false
ORDERBOOK_SUPPORTED_EXCHANGES=binance,tcbs
DUPLICATE_POSITION_POLICY=reject
REDIS_READ_COUNT=100
REDIS_BLOCK_MS=1000

# ─── External MDS connection for alpha containers ────────────────────────────
# Alpha containers join the MDS Docker network and reach Redis by this alias.
MDS_REDIS_URL=redis://mds-redis:6379
MDS_EXCHANGE=binance
