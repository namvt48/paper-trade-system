# ─── Ports ───────────────────────────────────────────────────────────────────
WEB_PORT=8097           # public port for the web dashboard
REDIS_PORT=6382         # public port for Redis (internal always 6379)

# ─── System ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REGISTERED_ALPHAS=15m-blend-close,15m-blend-close-b,15m-blend-close-c,15m-trend-close,15m-trend-vwap,1h-blend-close,1h-blend-close-b,1h-blend-close-c,1h-decay-close,1h-decay-vwap,4h-momentum-vwap,4h-trend-close,4h-trend-vwap,15m-blend-close-2-v3,1h-decay-close-v3,4h-trend-close-v3,4h-trend-z,15m-breakout,1h-trend-breakout,4h-amihud,1h-trend-skew,songthanv8,songthanv11,alpha-1-bangoc,alpha-1-v5b,alpha-1-v5b-2-8pct-reverse-blacklist-reverse-2-8pct,alpha-1-v5b-reverse-blacklist-base-reverse,alpha-2,hyper-turbo,alpha2-NR-Long-Short-M15,alpha2-NR-Long-Short-H1,deobietcophaialphakhong
DASHBOARD_CACHE_MS=1000
SIGNAL_RETENTION_DAYS=0

# ─── Worker ──────────────────────────────────────────────────────────────────
SLIPPAGE_PCT=0.05
ENABLE_ORDERBOOK=false
ORDERBOOK_SUPPORTED_EXCHANGES=binance
DUPLICATE_POSITION_POLICY=reject
REDIS_READ_COUNT=100
REDIS_BLOCK_MS=1000

# ─── External MDS connection for alpha containers ────────────────────────────
# Alpha containers join the MDS Docker network and reach Redis by this alias.
MDS_REDIS_URL=redis://mds-redis:6379
MDS_EXCHANGE=binance
